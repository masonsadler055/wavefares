# ─── WaveFares environment ─────────────────────────────────────────────────
# Copy to .env.local for local dev, or set these in your host's dashboard.
# Only the NEXT_PUBLIC_* values are exposed to the browser.

# Canonical site URL (used for metadata, canonical tags, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://wavefares.com

# ─── PRIMARY MONETIZATION SWITCH ───────────────────────────────────────────
# Sovrn //Commerce — the main way WaveFares earns. Free for publishers ($0 to
# join). Get the key from your Sovrn account and set it here; the root layout
# then loads the Sovrn script, which automatically converts outbound cruise
# links into commission-earning affiliate links. Until this is set, outbound
# links are plain cruise-line URLs and earn nothing.
NEXT_PUBLIC_SOVRN_API_KEY=

# ─── Display ads (secondary) ───────────────────────────────────────────────
# Google AdSense. When NEXT_PUBLIC_ADSENSE_CLIENT_ID is set, in-feed ad
# slots render after every 4 listing cards, labeled "Advertisement".
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=

# ─── Future data layer ─────────────────────────────────────────────────────
# Phase 1 serves data from typed files in src/data/. When the daily price
# checker moves to a database, it will connect with this URL (e.g. a
# Supabase Postgres connection string) — nothing reads it yet.
DATABASE_URL=

# Secret for the future daily price-check / revalidation endpoint
# (POST /api/revalidate). Generate a long random string before enabling it.
CRON_SECRET=
